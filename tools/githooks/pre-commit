#!/bin/sh

set -eu

# pre-commit.d/enabled에서 주석과 빈 줄을 걷어낸 단계 이름만 출력합니다.
pre_commit_read_enabled() (
	pre_commit_list=$1
	[ -f "$pre_commit_list" ] || return 0
	while IFS= read -r pre_commit_line || [ -n "$pre_commit_line" ]; do
		case "$pre_commit_line" in
		'#'* | '') continue ;;
		esac
		printf '%s\n' "$pre_commit_line"
	done <"$pre_commit_list"
)

pre_commit_main() (
	[ "$#" -eq 0 ] || {
		printf '오류[common.invalid-input]: pre-commit은 인자를 받지 않습니다\n조치: Git이 호출하는 그대로 실행하세요\n' >&2
		return 2
	}

	# 자기 경로를 기준으로 해석합니다. 저장소 루트를 조회하면 임시 저장소로 복사돼
	# 실행될 때 원본 저장소의 단계를 실행하게 됩니다.
	pre_commit_stage_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)/pre-commit.d
	pre_commit_list="$pre_commit_stage_dir/enabled"
	pre_commit_enabled=$(pre_commit_read_enabled "$pre_commit_list")
	pre_commit_executed=0
	pre_commit_disabled=0

	# 오타가 단계를 조용히 비활성화하지 않도록 먼저 이름을 검증합니다.
	while IFS= read -r pre_commit_name; do
		[ -n "$pre_commit_name" ] || continue
		case "$pre_commit_name" in
		script-tests | swift-format | build | compile | test) ;;
		*)
			printf '오류[common.invalid-input]: 알 수 없는 단계 이름 %s\n조치: %s 에서 제거하거나 오타를 고치세요\n' \
				"$pre_commit_name" "$pre_commit_list" >&2
			return 2
			;;
		esac
	done <<EOF
$pre_commit_enabled
EOF

	# 실행 순서는 enabled의 줄 순서가 아니라 아래 고정 순서를 따릅니다. 포매팅이
	# 파일을 바꾸면 뒤 단계의 빌드 대상이 달라지므로 swift-format이 먼저입니다.
	for pre_commit_stage in script-tests swift-format build compile test; do
		if ! printf '%s\n' "$pre_commit_enabled" | grep -qx -- "$pre_commit_stage"; then
			pre_commit_disabled=$((pre_commit_disabled + 1))
			continue
		fi

		pre_commit_script="$pre_commit_stage_dir/$pre_commit_stage.sh"
		[ -x "$pre_commit_script" ] || {
			printf '오류[common.invalid-input]: %s 단계가 활성화됐으나 %s를 실행할 수 없습니다\n조치: 스크립트를 추가하고 chmod +x 하거나 %s 에서 단계를 빼세요\n' \
				"$pre_commit_stage" "$pre_commit_script" "$pre_commit_list" >&2
			return 2
		}

		if "$pre_commit_script"; then
			pre_commit_executed=$((pre_commit_executed + 1))
		else
			pre_commit_status=$?
			printf '오류[pre-commit.step-failed]: %s 단계가 실패했습니다 (종료 상태 %s)\n조치: 위 단계의 출력을 확인해 원인을 해결한 뒤 다시 커밋하세요\n' \
				"$pre_commit_stage" "$pre_commit_status" >&2
			return "$pre_commit_status"
		fi
	done

	printf 'pre-commit 요약: 실행=%s 비활성=%s\n' "$pre_commit_executed" "$pre_commit_disabled"
)

pre_commit_main "$@"
