{
  "sourceLanguage" : "ko",
  "strings" : {
    "accountDeletionConfirmButtonTitle" : {
      "comment" : "계정 삭제 화면 하단의 삭제 확정 버튼 제목",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 삭제"
          }
        }
      }
    },
    "accountDeletionFailureMessage" : {
      "comment" : "계정 삭제 화면에서 삭제에 실패했을 때 보이는 안내",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제하지 못했어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "accountDeletionFirstParagraph" : {
      "comment" : "계정 삭제 화면 안내의 첫 번째 문단",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속 진행하면 깃잇에 저장된 모든 개인정보가 삭제됩니다. 학습 진도와 제작한 문제 또한 잃게 되니 주의하세요. 이 절차가 완료된 후에는 다시 되돌릴 수 없습니다."
          }
        }
      }
    },
    "accountDeletionSecondParagraph" : {
      "comment" : "계정 삭제 화면 안내의 두 번째 문단",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 삭제는 최대 30일까지 소요될 수 있습니다. 계정 비활성화 절차를 취소하고 계정을 복구하길 원하시면 서비스 메일로 문의해주세요."
          }
        }
      }
    },
    "accountDeletionThirdParagraph" : {
      "comment" : "계정 삭제 화면 안내의 세 번째 문단",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주의하세요.\n아래 “계정 삭제”를 클릭하면 즉시 삭제됩니다."
          }
        }
      }
    },
