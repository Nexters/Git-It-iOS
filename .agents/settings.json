{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.tools/issue-workflow/bin/check-branch.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
